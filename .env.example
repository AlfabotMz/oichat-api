# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Evolution API Configuration (WhatsApp)
EVOLUTION_API_URL=your_evolution_api_url
EVOLUTION_API_KEY=your_evolution_api_key

# Official WhatsApp Cloud API
WHATSAPP_CLOUD_VERIFY_TOKEN=your_whatsapp_cloud_verify_token

# System user tojen
SYSTEM_USER_TOKEN=your_system_user_token


APP_SECRET=your_app_secret
# AI / LLM Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
MODEL_NAME=openai/o4-mini

# Project Configuration
PROJECT_BASEURL=http://localhost:3000
